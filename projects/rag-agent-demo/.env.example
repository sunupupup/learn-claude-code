# 复制为运行环境配置；不要把真实密钥提交到 Git。
OPENAI_API_KEY=
# 可选的兼容 OpenAI API 的网关地址；留空表示使用默认地址。
OPENAI_BASE_URL=
# 最终回答模型；Embedding 模型由下面的 EMBEDDING_MODEL 单独配置。
MODEL_NAME=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
# Qdrant 地址和密钥；本地演示默认指向 localhost。
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_agent_demo
# RAG 召回参数：最多返回多少条，以及 cosine score 的最低门槛。
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.70
# Embedding 批大小和 Agent 预算，防止一次运行无限消耗资源。
EMBEDDING_BATCH_SIZE=64
AGENT_MAX_TURNS=3
AGENT_MAX_TOOL_CALLS=1
AGENT_MAX_REPAIR_ATTEMPTS=1
# 学习版默认重建索引；线上不要直接删除正在服务的 collection。
REBUILD_INDEX_ON_START=true
# 两类外部调用的超时，单位为秒。
MODEL_TIMEOUT_SECONDS=60
QDRANT_TIMEOUT_SECONDS=30
